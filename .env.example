# Host ports for docker compose. Change POSTGRES_PORT if 5432 is already taken
# by another project on this machine, and keep DATABASE_URL's port in step:
# host-side tools (alembic, scripts/) read DATABASE_URL and would otherwise
# connect to whatever else is listening on 5432.
POSTGRES_PORT=5432
API_PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/switchboard
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
